{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>MewsSystems/renovate-config"
  ],
  "enabledManagers": [
    "terraform",
    "terraform-version",
    "custom.regex",
    "gomod",
    "github-actions"
  ],
  "mode": "full",
  "packageRules": [
    {
      "groupName": "terraform-plugin",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/hashicorp/terraform-plugin-**"
      ]
    }
  ]
}
